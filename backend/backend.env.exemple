# =============================================================================
# backend/.env.example
# =============================================================================
# Copier en .env et remplir les valeurs — ne jamais committer .env
# Generate JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

# ---------------------------------------------------------------------------
# Environnement et serveur
# ---------------------------------------------------------------------------
NODE_ENV=development
# Options: development, staging, preprod, production
PORT=5000

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Local (docker-compose):
MONGODB_URI=mongodb://ayurMongoAdmin:change-me@mongodb:27017/ayur?authSource=admin

# Atlas (production):
# MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/ayur-db?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# JWT (JSON Web Tokens)
# ---------------------------------------------------------------------------
# Minimum 32 caractères — générer avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-at-least-32-characters-long-replace-this
JWT_EXPIRY=7d
# Options: 1d, 7d, 30d, 90d

# ---------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ---------------------------------------------------------------------------
# Development: localhost, staging: staging.domain, production: production.domain
CORS_ORIGIN=http://localhost:5173
# Pour plusieurs origines, séparées par des virgules: http://localhost:5173,https://staging.example.com

# Pour production, utiliser un domaine spécifique:
# CORS_ORIGIN=https://ayur-veda.example.com

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
# Fenêtre de temps (ms)
RATE_LIMIT_WINDOW=900000
# 900000 ms = 15 minutes

# Max requêtes par fenêtre
RATE_LIMIT_MAX_REQUESTS=100
# Adapter selon le trafic attendu

# Rate limit spécifique pour auth (register/login)
RATE_LIMIT_AUTH_WINDOW=900000
RATE_LIMIT_AUTH_MAX=5
# Limite l'enregistrement et la connexion pour éviter les attaques brute-force

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Format des logs
LOG_LEVEL=info
# Options: debug, info, warn, error, fatal

# En production, les logs sont en JSON pour faciliter le parsing
# LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Monitoring (optionnel)
# ---------------------------------------------------------------------------
# Sentry (error tracking)
# SENTRY_DSN=https://key@sentry.io/project-id

# Prometheus metrics
# ENABLE_METRICS=true

# ---------------------------------------------------------------------------
# Base de données (MongoDB)
# ---------------------------------------------------------------------------
# Créé automatiquement via docker-compose, configurable pour Atlas/production
MONGO_INITDB_ROOT_USERNAME=ayurMongoAdmin
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=ayur

# ---------------------------------------------------------------------------
# Seeding (données initiales)
# ---------------------------------------------------------------------------
# Si true, les seeds seront exécutées au démarrage
# SEED_ON_STARTUP=false

# Email de notification (optionnel)
# ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Secrets et clés (JAMAIS en plaintext en production)
# ---------------------------------------------------------------------------
# Utiliser GitHub Secrets, Infisical, ou Vault pour production
# Voir scripts/bootstrap-infisical.sh pour la configuration

# ---------------------------------------------------------------------------
# Développement uniquement
# ---------------------------------------------------------------------------
# Debug mode (plus verbose)
# DEBUG=express:*,ayur:*

# REPL mode (ts-node avec REPL au démarrage)
# REPL=true

# ---------------------------------------------------------------------------
# En dev : autoriser le frontend local
# En prod : https://ayur-veda.fr (défini dans docker-compose.yml)
CORS_ORIGIN=http://localhost:3000
