# Docker et config locale
Dockerfile*
docker-compose*.yml
.dockerignore

# Qualité de code — pas utile dans l'image
.pre-commit-config.yaml
.eslintrc*
.prettierrc*

# Dépendances — réinstallées proprement dans l'image
node_modules
npm-debug.log
.eslintcache

# Le dist/ local — c'est le builder qui le génère
dist

# Secrets — ne jamais envoyer dans le contexte Docker
.env
.env.*

# Git et outils dev
.git
.gitignore
.DS_Store

# Tests
coverage
**/*.test.ts
**/*.spec.ts

# Docs
README.md
*.md
