# Frontend .env.example
# Copie ce fichier en .env et adapte les valeurs selon ton environnement

# =============================================================================
# API Backend
# =============================================================================
VITE_API_BASE_URL=http://localhost:5000/api

# Pour production, utilise l'URL absolue :
# VITE_API_BASE_URL=https://api.ayur-veda.example.com/api

# Pour staging :
# VITE_API_BASE_URL=https://api-staging.ayur-veda.example.com/api

# =============================================================================
# Environnement
# =============================================================================
VITE_ENVIRONMENT=development
# Options: development, staging, production

# =============================================================================
# Analytics & Monitoring (optionnel)
# =============================================================================
# Google Analytics
# VITE_GA_ID=G-XXXXXXXXXX

# Sentry (error tracking)
# VITE_SENTRY_DSN=https://key@sentry.io/project-id

# =============================================================================
# Debug
# =============================================================================
# Enable debug logs
VITE_DEBUG=false
